# Copy to .env (in this folder or backend/) and fill in. Every value is optional.

# Claude news analyst + narrative. Without it, news is scored by a built-in finance lexicon.
ANTHROPIC_API_KEY=""
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher = more careful news judgement, more cost.
LLM_EFFORT=high

# Optional fallback price providers
TWELVEDATA_API_KEY=
COINGECKO_API_KEY=

# Scheduled runs (local times, 24h) and timezone (IANA name, or Local)
RUN_TIMES=07:30,22:30
TIMEZONE=Local
SCAN_ON_SCHEDULE=true
SCAN_UNIVERSES=us_large_caps,global,crypto
SCAN_HORIZON=1w

# On-demand research reports (Research tab): Claude searches and reads the web about one
# coin, token or stock (about $1-3 per report). Runs only when you press the button; this
# caps the total per calendar month.
RESEARCH_BUDGET_USD=25

# Company financials come from SEC EDGAR (free). The SEC asks every user to identify
# themselves with a name and contact email, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=

# Optional Telegram alerts after scheduled runs: signal changes, live-record drift,
# journal stops/targets and the losing-streak circuit-breaker. Create a bot with
# @BotFather, send it a message, then find your chat id at
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=http://localhost:8080

# Watchlist seeded on first start
DEFAULT_WATCHLIST=SPY,AAPL,NVDA,BTC-USD,ETH-USD

# PostgreSQL connection. Everything (reports, predictions, earnings, price history,
# trained models, Claude usage) lives here; tables are created on start.
DATABASE_URL=postgres://root:root@localhost:5432/market_oracle

ADDR=:8080
# Only used by "-import-sqlite" to bring over data from the old file storage.
DATA_DIR=./data
FRONTEND_DIR=../frontend/dist
# How long downloaded price history is reused before refetching
CACHE_MAX_AGE=3h

# Earnings history start date (Nasdaq calendar). "off" disables earnings features.
EARNINGS_FROM=2010-01-01
# Cross-asset models: years of history to train on, and how often to retrain
POOLED_YEARS=16
RETRAIN_AFTER=20h

# ---- Accounts ----
# The public address of the app. Links in invite and reset emails use it, and an
# https:// address marks the sign-in cookie Secure (sent over HTTPS only).
APP_URL=http://localhost:8080
# "invite" (default): joining needs an invite link from an admin. "open": anyone can sign up.
SIGNUP=invite
# Set to true only when running behind your own reverse proxy (nginx, Caddy, a
# load balancer), so sign-in rate limits see the visitor's real address.
TRUST_PROXY=false
# Allowances for members (admins have none): AI-assisted refreshes per day, and
# research reports per calendar month. RESEARCH_BUDGET_USD still caps the total.
MEMBER_AI_RUNS_PER_DAY=10
MEMBER_RESEARCH_PER_MONTH=2
# Password-reset emails. Without these, "Forgot password" tells people to ask an
# admin, who can make a reset link on the Admin page. Port 465 = TLS, otherwise STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
